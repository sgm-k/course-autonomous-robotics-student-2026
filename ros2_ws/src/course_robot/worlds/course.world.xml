<?xml version="1.0"?>
<mvsim_world version="1.0">
  <!-- Lightweight world: no textures, remote assets, cameras, or 3D lidar. -->
  <simul_timestep>0</simul_timestep>

  <gui>
    <ortho>true</ortho>
    <show_forces>false</show_forces>
    <cam_distance>14</cam_distance>
    <cam_azimuth>180</cam_azimuth>
    <cam_elevation>90</cam_elevation>
    <refresh_fps>15</refresh_fps>
  </gui>

  <lights>
    <enable_shadows>false</enable_shadows>
  </lights>

  <element class="horizontal_plane">
    <x_min>-8</x_min><y_min>-6</y_min>
    <x_max>8</x_max><y_max>6</y_max>
    <z>0.0</z>
    <color>#eeeeee</color>
  </element>

  <element class="ground_grid">
    <floating>true</floating>
  </element>

  <!-- MVSim同梱の単純な車体定義を使い、外部ネットワークへのアクセスを避ける。 -->
  <include file="/opt/ros/jazzy/share/mvsim/definitions/small_robot.vehicle.xml"/>

  <vehicle name="robot" class="small_robot">
    <init_pose>-5 -3 0</init_pose>
    <include
      file="/opt/ros/jazzy/share/mvsim/definitions/lidar2d.sensor.xml"
      sensor_x="0.5" sensor_y="0.0" sensor_z="0.70"
      sensor_yaw="0.0" sensor_name="laser1"
      fov_degrees="180" sensor_period_sec="0.10"
      sensor_nrays="181" max_range="8.0"
      raytrace_3d="false" sensor_custom_visual="false"/>
  </vehicle>

  <!-- Boundary and internal walls. Each pair of points is one wall segment. -->
  <walls>
    <color>#404040</color>
    <wallThickness>0.12</wallThickness>
    <wallHeight>0.8</wallHeight>
    <shape>
      <pt>-7 -5</pt><pt>7 -5</pt>
      <pt>7 -5</pt><pt>7 5</pt>
      <pt>7 5</pt><pt>-7 5</pt>
      <pt>-7 5</pt><pt>-7 -5</pt>
      <pt>-2 -5</pt><pt>-2 1</pt>
      <pt>-2 2.5</pt><pt>-2 5</pt>
      <pt>2 -5</pt><pt>2 -1.5</pt>
      <pt>2 0</pt><pt>2 5</pt>
      <pt>-2 1</pt><pt>0 1</pt>
      <pt>3 2</pt><pt>7 2</pt>
      <!-- Box obstacle around (0,-2). -->
      <pt>-0.35 -2.35</pt><pt>0.35 -2.35</pt>
      <pt>0.35 -2.35</pt><pt>0.35 -1.65</pt>
      <pt>0.35 -1.65</pt><pt>-0.35 -1.65</pt>
      <pt>-0.35 -1.65</pt><pt>-0.35 -2.35</pt>
      <!-- Box obstacle around (4,0). -->
      <pt>3.65 -0.35</pt><pt>4.35 -0.35</pt>
      <pt>4.35 -0.35</pt><pt>4.35 0.35</pt>
      <pt>4.35 0.35</pt><pt>3.65 0.35</pt>
      <pt>3.65 0.35</pt><pt>3.65 -0.35</pt>
      <!-- Box obstacle around (-4,3). -->
      <pt>-4.35 2.65</pt><pt>-3.65 2.65</pt>
      <pt>-3.65 2.65</pt><pt>-3.65 3.35</pt>
      <pt>-3.65 3.35</pt><pt>-4.35 3.35</pt>
      <pt>-4.35 3.35</pt><pt>-4.35 2.65</pt>
    </shape>
  </walls>

</mvsim_world>
