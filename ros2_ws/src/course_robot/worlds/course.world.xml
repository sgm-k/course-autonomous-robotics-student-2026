<?xml version="1.0"?>
<mvsim_world version="1.0">
  <!-- Lightweight world: no textures, remote assets, cameras, or 3D lidar. -->
  <simul_timestep>0</simul_timestep>

  <gui>
    <ortho>true</ortho>
    <show_forces>false</show_forces>
    <cam_distance>7</cam_distance>
    <cam_azimuth>180</cam_azimuth>
    <cam_elevation>90</cam_elevation>
    <refresh_fps>15</refresh_fps>
  </gui>

  <lights>
    <enable_shadows>false</enable_shadows>
  </lights>

  <element class="horizontal_plane">
    <x_min>-4</x_min><y_min>-3</y_min>
    <x_max>4</x_max><y_max>3</y_max>
    <z>0.0</z>
    <color>#eeeeee</color>
  </element>

  <element class="ground_grid">
    <floating>true</floating>
  </element>

  <!-- TurtleBot3 Burger 相当のロボット。MVSim 同梱の定義をもとに、3D モデルを教材に同梱し、
       外部ネットワークへのアクセスをなくした。LiDAR は実機（LDS）に合わせて 360 度・最大 3.5 m。 -->
  <include file="course_burger.vehicle.xml"/>

  <vehicle name="robot" class="course_burger">
    <init_pose>-2.5 -1.5 0</init_pose>
  </vehicle>

  <!-- Boundary and internal walls. Each pair of points is one wall segment. -->
  <walls>
    <color>#404040</color>
    <wallThickness>0.06</wallThickness>
    <wallHeight>0.3</wallHeight>
    <shape>
      <pt>-3.5 -2.5</pt><pt>3.5 -2.5</pt>
      <pt>3.5 -2.5</pt><pt>3.5 2.5</pt>
      <pt>3.5 2.5</pt><pt>-3.5 2.5</pt>
      <pt>-3.5 2.5</pt><pt>-3.5 -2.5</pt>
      <pt>-1 -2.5</pt><pt>-1 0.5</pt>
      <pt>-1 1.25</pt><pt>-1 2.5</pt>
      <pt>1 -2.5</pt><pt>1 -0.75</pt>
      <pt>1 0</pt><pt>1 2.5</pt>
      <pt>-1 0.5</pt><pt>0 0.5</pt>
      <pt>1.5 1</pt><pt>3.5 1</pt>
      <!-- Box obstacle around (0,-1). -->
      <pt>-0.175 -1.175</pt><pt>0.175 -1.175</pt>
      <pt>0.175 -1.175</pt><pt>0.175 -0.825</pt>
      <pt>0.175 -0.825</pt><pt>-0.175 -0.825</pt>
      <pt>-0.175 -0.825</pt><pt>-0.175 -1.175</pt>
      <!-- Box obstacle around (2,0). -->
      <pt>1.825 -0.175</pt><pt>2.175 -0.175</pt>
      <pt>2.175 -0.175</pt><pt>2.175 0.175</pt>
      <pt>2.175 0.175</pt><pt>1.825 0.175</pt>
      <pt>1.825 0.175</pt><pt>1.825 -0.175</pt>
      <!-- Box obstacle around (-2,1.5). -->
      <pt>-2.175 1.325</pt><pt>-1.825 1.325</pt>
      <pt>-1.825 1.325</pt><pt>-1.825 1.675</pt>
      <pt>-1.825 1.675</pt><pt>-2.175 1.675</pt>
      <pt>-2.175 1.675</pt><pt>-2.175 1.325</pt>
    </shape>
  </walls>

</mvsim_world>
